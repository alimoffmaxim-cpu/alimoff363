# Скопируйте в .env на СВОЁМ сервере:  cp .env.example .env && chmod 600 .env
# Никогда не коммитьте .env и не отправляйте его содержимое в чаты (включая чат с ИИ).

# Токен от @BotFather
BOT_TOKEN=

# Ваш числовой Telegram ID (узнать: @userinfobot). Только этот пользователь получит ответ бота.
OWNER_ID=

# Мастер-ключ шифрования (32 байта base64). Сгенерировать:  python -m finbot genkey
MASTER_KEY=

# Необязательные настройки
DB_PATH=data/finance.db
SESSION_MINUTES=1
AUTO_DELETE_MINUTES=1
TIMEZONE=Asia/Bangkok

# Адрес мини-аппа с дашбордом. Установщик на сервере настраивает его сам (страница раздаётся с вашего сервера). Пусто — дашборд картинкой.
WEBAPP_URL=
